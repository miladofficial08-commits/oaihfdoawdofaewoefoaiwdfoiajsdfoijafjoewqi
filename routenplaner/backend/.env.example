# ─── Zugang ──────────────────────────────────────────────────────────────────
# Gemeinsames Passwort für alle, die die App benutzen. Bleibt es leer, ist die
# API für jeden offen, der die Adresse kennt. Im Feldeinsatz setzen.
APP_PASSWORT=bitte-aendern

# Woher das Frontend kommen darf. "*" erlaubt alles und ist für Netlify-
# Vorschau-Deploys praktisch; für den Dauerbetrieb die Netlify-Adresse eintragen.
CORS_ORIGIN=*

# ─── Datenhaltung ────────────────────────────────────────────────────────────
# Railway setzt RAILWAY_VOLUME_MOUNT_PATH automatisch, sobald ein Volume
# gemountet ist. OHNE Volume liegt die Datenbank im Container und ist beim
# nächsten Deploy weg — samt aller Besuchsprotokolle.
# SQLITE_DB_PATH=/data/routen.db

# ─── Startpunkt ──────────────────────────────────────────────────────────────
START_ADRESSE=Dillenburger Weg 17, 40229 Düsseldorf
# Nur Rückfall, falls das Geocoding nicht erreichbar ist (Mittelpunkt Eller):
# START_LAT=51.2033
# START_LON=6.8419

# ─── Vorgaben ────────────────────────────────────────────────────────────────
RADIUS_KM=6
STOPPS_PRO_TAG=18

# ─── Externe Dienste ─────────────────────────────────────────────────────────
# Nominatim und der öffentliche OSRM-Server verlangen einen aussagekräftigen
# User-Agent mit Kontaktmöglichkeit. Bitte eigene E-Mail eintragen.
HTTP_USER_AGENT=praxis-routenplaner/1.0 (Krankenfahrten-Akquise; kontakt@example.de)

# Eigener OSRM-Server statt des Demo-Servers (empfohlen für Dauerbetrieb,
# der Demo-Server drosselt und kennt eine Matrixgrenze von 100 Punkten):
# OSRM_BASE=https://routing.example.de

# Optional: schließt die Lücken, die OpenStreetMap bei Arztpraxen hat.
# Kostet pro Anfrage — /api/import/kosten rechnet es vorher aus.
# GOOGLE_PLACES_KEY=
